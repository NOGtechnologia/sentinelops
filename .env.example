# SentinelOps - copy to .env and adjust. Used by deploy/docker-compose.yml (--env-file .env).
# Never commit .env. All values below are placeholders.

# --- required ----------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-database-password
# HMAC key for action approvals, at least 32 characters (e.g. `openssl rand -hex 32`)
SENTINELOPS_APPROVAL_SECRET=change-me-to-a-random-value-of-at-least-32-characters

# --- demo mode ---------------------------------------------------------------------------------
# true: loads the fictitious Musterfirma data, fixes the clock and offers demo logins.
# Demo logins exist ONLY in demo mode. Set to false for real use (OIDC required).
SENTINELOPS_DEMO_MODE=true
SENTINELOPS_DEMO_NOW=2026-03-12T10:30:00+01:00
SENTINELOPS_DISPLAY_TZ=Europe/Berlin
SENTINELOPS_PORT=8080

# --- AI summary (docs/ai.md) -------------------------------------------------------------------
# none | mock (demo simulator, no model) | ollama | openai | anthropic
SENTINELOPS_LLM_PROVIDER=mock
# SENTINELOPS_LLM_BASE_URL=http://ollama:11434
# SENTINELOPS_LLM_MODEL=llama3.1
# Cloud providers send (pseudonymised) evidence to a third party - explicit opt-in required:
# SENTINELOPS_LLM_CLOUD_OPT_IN=true
# SENTINELOPS_LLM_API_KEY=

# --- OIDC with the bundled Keycloak (docker compose --profile oidc ...) --------------------------
# KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# KEYCLOAK_PUBLIC_URL=http://localhost:8081
# SENTINELOPS_OIDC_ISSUER=http://localhost:8081/realms/sentinelops
# SENTINELOPS_OIDC_JWKS_URL=http://keycloak:8080/realms/sentinelops/protocol/openid-connect/certs
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# --- ingestion ---------------------------------------------------------------------------------
# Syslog receiver on UDP+TCP (also publish the port in docker-compose.yml)
# SENTINELOPS_SYSLOG_PORT=5514

# --- retention (days, 0 = keep) ----------------------------------------------------------------
SENTINELOPS_RETENTION_EVENTS_DAYS=90
